{
  "domain": "candy_simplyfi",
  "name": "Candy Simply-Fi Local",
  "version": "1.1.0",
  "documentation": "https://github.com/benedettosiddi/candysimply",
  "issue_tracker": "https://github.com/benedettosiddi/candysimply/issues",
  "dependencies": [],
  "codeowners": ["@benedettosiddi"],
  "config_flow": true,
  "integration_type": "device",
  "iot_class": "local_polling",
  "zeroconf": [
    {
      "type": "_http._tcp.local.",
      "name": "CANDY*"
    },
    {
      "type": "_http._tcp.local.",
      "name": "candy*"
    },
    {
      "type": "_http._tcp.local.",
      "name": "HOOVER*"
    },
    {
      "type": "_http._tcp.local.",
      "name": "hoover*"
    },
    {
      "type": "_http._tcp.local.",
      "name": "*simplyfi*"
    },
    {
      "type": "_http._tcp.local.",
      "name": "*SIMPLYFI*"
    },
    {
      "type": "_http._tcp.local.",
      "name": "*WIFI_*"
    }
  ],
  "dhcp": [
    {
      "hostname": "candy*",
      "match_type": "prefix"
    },
    {
      "hostname": "CANDY*",
      "match_type": "prefix"
    },
    {
      "hostname": "hoover*",
      "match_type": "prefix"
    },
    {
      "hostname": "HOOVER*",
      "match_type": "prefix"
    },
    {
      "hostname": "*simplyfi*",
      "match_type": "glob"
    },
    {
      "macaddress": "00054F*"
    },
    {
      "macaddress": "246F28*"
    },
    {
      "macaddress": "30AEA4*"
    },
    {
      "macaddress": "D88039*"
    },
    {
      "macaddress": "0013E0*"
    }
  ],
  "ssdp": [
    {
      "manufacturer": "Candy"
    },
    {
      "manufacturer": "Candy Hoover Group"
    },
    {
      "manufacturer": "Hoover"
    },
    {
      "manufacturer": "Haier"
    }
  ]
}
